# Foodground VS-2 script environment variables
# Copy this file to .env and fill in your local paths before running any scripts/vs2_* script.
# .env is gitignored and must never be committed.

# Path to analysis_outputs/ directory (contains food_master.csv, ingredient_matching.csv, etc.)
FOODGROUND_ANALYSIS_DIR=

# Path to recipes.db (SQLite, contains recipes / ingredients / recipe_ingredients)
FOODGROUND_RECIPE_DB=

# Path to foodground.db (SQLite, contains facility table)
FOODGROUND_FACILITY_DB=

# (Optional) Explicit path to python.exe; auto-detected from PATH if not set
FOODGROUND_PYTHON_EXE=

# Supabase service-role connection URL (postgres://...) — required for DB operations
# Never commit this value. Set in your shell or PowerShell session only.
# SUPABASE_DB_URL=
